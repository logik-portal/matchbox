<?xml version="1.0" encoding="UTF-8"?>
<ShaderNodePreset SupportsAdaptiveDegradation="0" Description="Procedural snow with sway, sparkle, clustering and depth layers. Output on black - Screen or Add." Name="MM_Snow">

   <Shader OutputBitDepth="Output" Index="1">

      <!-- Page 0 Col 0 – Shape (5 rows max) -->
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.57" Inc="0.01" Row="0" Col="0" Page="0" DisplayName="Density" Type="float" Name="Density" Tooltip="Master flake density">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.05" Default="0.24" Inc="0.01" Row="1" Col="0" Page="0" DisplayName="Size" Type="float" Name="Size" Tooltip="Flake size">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.29" Inc="0.01" Row="2" Col="0" Page="0" DisplayName="Size Variation" Type="float" Name="SizeVariation" Tooltip="Random size variety between flakes">
      </Uniform>
      <Uniform ResDependent="None" Max="45.0" Min="-45.0" Default="0.0" Inc="0.5" Row="3" Col="0" Page="0" DisplayName="Wind Angle" Type="float" Name="WindAngle" Tooltip="Fall angle. 0 = straight down, positive = right">
      </Uniform>
      <Uniform ResDependent="None" Max="20.0" Min="0.0" Default="4.0" Inc="0.5" Row="4" Col="0" Page="0" DisplayName="Gust Strength" Type="float" Name="GustStrength" Tooltip="Gust swing amplitude in degrees">
      </Uniform>

      <!-- Page 0 Col 1 – Turbulence (5 rows max) -->
      <Uniform ResDependent="None" Max="4.0" Min="0.0" Default="1.0" Inc="0.1" Row="0" Col="1" Page="0" DisplayName="Gust Speed" Type="float" Name="GustSpeed" Tooltip="How fast gusts evolve">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="1.0" Inc="0.01" Row="1" Col="1" Page="0" DisplayName="Sway" Type="float" Name="SwayAmount" Tooltip="Lateral drift amount - the gentle side-to-side motion of falling snow">
      </Uniform>
      <Uniform ResDependent="None" Max="4.0" Min="0.2" Default="1.2" Inc="0.1" Row="2" Col="1" Page="0" DisplayName="Sway Scale" Type="float" Name="SwayScale" Tooltip="Size of groups of flakes swaying together - low = broad drifting gusts, high = independent flakes">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="1.0" Inc="0.01" Row="3" Col="1" Page="0" DisplayName="Patchiness" Type="float" Name="SwirlAmount" Tooltip="Brightness variation - darker and lighter volumes of snow breaking up the flat look">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.6" Inc="0.01" Row="4" Col="1" Page="0" DisplayName="Clustering" Type="float" Name="ClusterAmount" Tooltip="Large masses of dense snowfall separated by lighter gaps">
      </Uniform>

      <!-- Page 0 Col 2 – Sparkle (5 rows max) -->
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.30" Inc="0.01" Row="0" Col="2" Page="0" DisplayName="Flurry Amount" Type="float" Name="FlurryAmount" Tooltip="Fine fast haze layer of tiny flakes - blizzard/flurry feel">
      </Uniform>
      <Uniform ResDependent="None" Max="4.0" Min="0.2" Default="1.4" Inc="0.05" Row="1" Col="2" Page="0" DisplayName="Patch Scale" Type="float" Name="PatchScale" Tooltip="Size of Patchiness brightness variation">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="1.0" Inc="0.01" Row="2" Col="2" Page="0" DisplayName="Sparkle Amount" Type="float" Name="SparkleAmount" Tooltip="Occasional bright glinting flakes">
      </Uniform>
      <Uniform ResDependent="None" Max="16.0" Min="0.5" Default="10.0" Inc="0.5" Row="3" Col="2" Page="0" DisplayName="Sparkle Sharpness" Type="float" Name="SparkleSharpness" Tooltip="How tight/brief the sparkle glints are">
      </Uniform>
      <Uniform ResDependent="None" Max="4.0" Min="0.1" Default="3.55" Inc="0.05" Row="4" Col="2" Page="0" DisplayName="Sparkle Speed" Type="float" Name="SparkleSpeed" Tooltip="How fast flakes twinkle">
      </Uniform>

      <!-- Page 1 Col 0 – Speed (4 rows) -->
      <Uniform ResDependent="None" Max="2.0" Min="0.05" Default="0.35" Inc="0.05" Row="0" Col="0" Page="1" DisplayName="FG Speed" Type="float" Name="FGSpeed" Tooltip="Foreground layer fall speed - large near flakes">
      </Uniform>
      <Uniform ResDependent="None" Max="2.0" Min="0.05" Default="0.22" Inc="0.05" Row="1" Col="0" Page="1" DisplayName="Mid Speed" Type="float" Name="MidSpeed" Tooltip="Mid layer fall speed">
      </Uniform>
      <Uniform ResDependent="None" Max="1.5" Min="0.02" Default="0.12" Inc="0.02" Row="2" Col="0" Page="1" DisplayName="BG Speed" Type="float" Name="BGSpeed" Tooltip="Background layer fall speed - fine distant flakes">
      </Uniform>
      <Uniform ResDependent="None" Max="3.0" Min="0.05" Default="0.05" Inc="0.05" Row="3" Col="0" Page="1" DisplayName="Global Speed" Type="float" Name="GlobalSpeed" Tooltip="Overall speed multiplier for the whole effect - lower for gentle, slow-falling snow">
      </Uniform>

      <!-- Page 1 Col 1 – Enable (4 rows) -->
      <Uniform Row="0" Col="1" Page="1" DisplayName="Snow On" Default="True" Tooltip="Master on/off for the whole effect" Type="bool" Name="SnowEnable">
      </Uniform>
      <Uniform Row="1" Col="1" Page="1" DisplayName="FG On" Default="True" Tooltip="Toggle the foreground flake layer" Type="bool" Name="FGEnable">
      </Uniform>
      <Uniform Row="2" Col="1" Page="1" DisplayName="Mid On" Default="True" Tooltip="Toggle the mid flake layer" Type="bool" Name="MidEnable">
      </Uniform>
      <Uniform Row="3" Col="1" Page="1" DisplayName="BG On" Default="True" Tooltip="Toggle the background flake layer" Type="bool" Name="BGEnable">
      </Uniform>

      <!-- Page 2 Col 0 – Position (3 rows) -->
      <Uniform ResDependent="None" Max="100000.0" Min="-100000.0" Default="0.0" Inc="1.0" Row="0" Col="0" Page="2" DisplayName="Position X" Type="float" Name="PosX" Tooltip="Horizontal position in pixels">
      </Uniform>
      <Uniform ResDependent="None" Max="100000.0" Min="-100000.0" Default="0.0" Inc="1.0" Row="1" Col="0" Page="2" DisplayName="Position Y" Type="float" Name="PosY" Tooltip="Vertical position in pixels">
      </Uniform>
      <Uniform ResDependent="None" Max="180.0" Min="-180.0" Default="0.0" Inc="0.1" Row="2" Col="0" Page="2" DisplayName="Rotation" Type="float" Name="Rotation" Tooltip="Rotates the whole snow field">
      </Uniform>

      <!-- Page 2 Col 1 – Global Transform (3 rows) -->
      <Uniform ResDependent="None" Max="100000.0" Min="-100000.0" Default="0.0" Inc="1.0" Row="0" Col="1" Page="2" DisplayName="Global X" Type="float" Name="GlobalX" Tooltip="Global horizontal offset, applied after Position/Rotation">
      </Uniform>
      <Uniform ResDependent="None" Max="100000.0" Min="-100000.0" Default="0.0" Inc="1.0" Row="1" Col="1" Page="2" DisplayName="Global Y" Type="float" Name="GlobalY" Tooltip="Global vertical offset, applied after Position/Rotation">
      </Uniform>
      <Uniform ResDependent="None" Max="10.0" Min="0.1" Default="1.0" Inc="0.01" Row="2" Col="1" Page="2" DisplayName="Global Scale" Type="float" Name="GlobalScale" Tooltip="Zooms the whole snow field around frame centre">
      </Uniform>

      <!-- Page 3 Col 0 – Crop (4 rows) -->
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.0" Inc="0.01" Row="0" Col="0" Page="3" DisplayName="Crop Left" Type="float" Name="CropL">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.0" Inc="0.01" Row="1" Col="0" Page="3" DisplayName="Crop Right" Type="float" Name="CropR">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.0" Inc="0.01" Row="2" Col="0" Page="3" DisplayName="Crop Top" Type="float" Name="CropT">
      </Uniform>
      <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="0.0" Inc="0.01" Row="3" Col="0" Page="3" DisplayName="Crop Bottom" Type="float" Name="CropB">
      </Uniform>

      <!-- Page 3 Col 1 – Edge Softness (4 rows) -->
      <Uniform ResDependent="None" Max="0.5" Min="0.0" Default="0.0" Inc="0.01" Row="0" Col="1" Page="3" DisplayName="Soft Left" Type="float" Name="SoftL">
      </Uniform>
      <Uniform ResDependent="None" Max="0.5" Min="0.0" Default="0.0" Inc="0.01" Row="1" Col="1" Page="3" DisplayName="Soft Right" Type="float" Name="SoftR">
      </Uniform>
      <Uniform ResDependent="None" Max="0.5" Min="0.0" Default="0.0" Inc="0.01" Row="2" Col="1" Page="3" DisplayName="Soft Top" Type="float" Name="SoftT">
      </Uniform>
      <Uniform ResDependent="None" Max="0.5" Min="0.0" Default="0.0" Inc="0.01" Row="3" Col="1" Page="3" DisplayName="Soft Bottom" Type="float" Name="SoftB">
      </Uniform>

      <!-- Page 3 Col 2 – Enable (4 rows) -->
      <Uniform Row="0" Col="2" Page="3" DisplayName="Left On" Default="False" Type="bool" Name="CropLOn">
      </Uniform>
      <Uniform Row="1" Col="2" Page="3" DisplayName="Right On" Default="False" Type="bool" Name="CropROn">
      </Uniform>
      <Uniform Row="2" Col="2" Page="3" DisplayName="Top On" Default="False" Type="bool" Name="CropTOn">
      </Uniform>
      <Uniform Row="3" Col="2" Page="3" DisplayName="Bottom On" Default="False" Type="bool" Name="CropBOn">
      </Uniform>

      <!-- Page 4 Col 0 – Light Source (4 rows) -->
      <Uniform ResDependent="None" Max="2.0" Min="-1.0" Default="0.5" Inc="0.001" Row="0" Col="0" Page="4" DisplayName="Light X" Type="float" Name="LightX" Tooltip="Horizontal position of the light source, 0-1 across the frame">
      </Uniform>
      <Uniform ResDependent="None" Max="2.0" Min="-1.0" Default="0.5" Inc="0.001" Row="1" Col="0" Page="4" DisplayName="Light Y" Type="float" Name="LightY" Tooltip="Vertical position of the light source, 0-1 across the frame">
      </Uniform>
      <Uniform ResDependent="None" Max="2.0" Min="0.0" Default="0.15" Inc="0.005" Row="2" Col="0" Page="4" DisplayName="Radius" Type="float" Name="LightRadius" Tooltip="Radius of full brightness boost around the light">
      </Uniform>
      <Uniform ResDependent="None" Max="2.0" Min="0.001" Default="0.35" Inc="0.005" Row="3" Col="0" Page="4" DisplayName="Falloff" Type="float" Name="LightFalloff" Tooltip="Distance beyond the radius over which the brightness fades back to normal">
      </Uniform>

      <!-- Page 4 Col 1 – Light Look (2 rows) -->
      <Uniform ResDependent="None" Max="5.0" Min="0.0" Default="1.5" Inc="0.05" Row="0" Col="1" Page="4" DisplayName="Intensity" Type="float" Name="LightIntensity" Tooltip="How much brighter snow gets near the light - 0 disables the effect">
      </Uniform>
      <Uniform Row="1" Col="1" Page="4" DisplayName="Show Light" Default="False" Tooltip="Draws the radius/falloff rings and a crosshair at the light position as a setup aid. Turn off before final render." Type="bool" Name="ShowLight">
      </Uniform>

   </Shader>

   <Page Name="Snow" Page="0">
      <Col Name="Shape" Col="0" Page="0">
      </Col>
      <Col Name="Turbulence" Col="1" Page="0">
      </Col>
      <Col Name="Sparkle" Col="2" Page="0">
      </Col>
   </Page>

   <Page Name="Speed" Page="1">
      <Col Name="Speed" Col="0" Page="1">
      </Col>
      <Col Name="Enable" Col="1" Page="1">
      </Col>
   </Page>

   <Page Name="Transform" Page="2">
      <Col Name="Position" Col="0" Page="2">
      </Col>
      <Col Name="Global" Col="1" Page="2">
      </Col>
   </Page>

   <Page Name="Crop" Page="3">
      <Col Name="Crop" Col="0" Page="3">
      </Col>
      <Col Name="Soft Edge" Col="1" Page="3">
      </Col>
      <Col Name="Enable" Col="2" Page="3">
      </Col>
   </Page>

   <Page Name="Light" Page="4">
      <Col Name="Source" Col="0" Page="4">
      </Col>
      <Col Name="Look" Col="1" Page="4">
      </Col>
   </Page>

</ShaderNodePreset>
