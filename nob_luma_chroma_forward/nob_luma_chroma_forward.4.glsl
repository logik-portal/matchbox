vec3 vpow(vec3 x, float y) {
    return vec3(pow(x.r, y), pow(x.g, y), pow(x.b, y));
}

vec3 trc_709(vec3 x) {
    const vec3 s = sign(x);
    x = abs(x);
    return s * mix(vpow(fma(vec3(.909672413), x, vec3(.090327587)), 2.22222222), .222222222 * x, lessThan(x, vec3(.0812428582)));
}

vec3 trc_srgb(vec3 x) {
    const vec3 s = sign(x);
    x = abs(x);
    return s * mix(vpow(fma(vec3(.947857667), x, vec3(.0521423327)), 2.4), .0773993808 * x, lessThan(x, vec3(.0392933707)));
}

vec3 trc_pq(vec3 x) {
    x = vpow(x, .0126833135);
    x = fma(vec3(.111442876), x, vec3(-.0931592789)) / (1.00877926 - x);
    return vpow(max(x, 0.), 6.27739464);
}

vec3 trc_st_428_1(vec3 x) {
    const vec3 s = sign(x);
    x = 1.09104167 * vpow(abs(x), 2.6);
    return s * x;
}

vec3 trc_hlg(vec3 x) {
    const vec3 s = sign(x);
    x = abs(x);
    x = mix(3.33333333 * (x * x), exp2(fma(vec3(8.06728566), x, vec3(-4.77999421))) + vec3(.2372241), lessThan(vec3(.5), x));
    return (.001 * l_w) * (s * x);
}

vec3 trc_1886(const vec3 x) {
    return sign(x) * vpow(abs(x), 2.4);
}

