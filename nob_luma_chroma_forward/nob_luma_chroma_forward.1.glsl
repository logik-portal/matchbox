    return s * mix(fma(vec3(1.05501072), vpow(x, .416666667), vec3(-.0550107189)), 12.92 * x, lessThan(x, vec3(.00304128256)));
}

vec3 trc_pq(vec3 x) {
    const vec3 s = sign(x);
    x = vpow(abs(x), .159301758);
    x = fma(vec3(1.00877926), x, vec3(.0931592789)) / (.111442876 + x);
    return s * vpow(x, 78.84375);
}

vec3 trc_st_428_1(vec3 x) {
