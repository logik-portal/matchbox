vec3 vpow(vec3 x, float y) {
    return vec3(pow(x.r, y), pow(x.g, y), pow(x.b, y));
}

vec3 trc_709(vec3 x) {
    const vec3 s = sign(x);
    x = abs(x);
    return s * mix(fma(vec3(1.09929683), vpow(x, .45), vec3(-.0992968268)), 4.5 * x, lessThan(x, vec3(.0180539685)));
}

vec3 trc_srgb(vec3 x) {
