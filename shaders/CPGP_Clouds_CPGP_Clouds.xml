<ShaderNodePreset SupportsAdaptiveDegradation="0" Description="This Matchbox shader cloud generation.
Inputs:
 - Front Noise: a noise texture
Params:
 - Clouds Rotation : the clouds rotation on X/Y axis
 - Speed: the speed for movement
 - Procedural generation: use procedural generation
    Based on https://www.shadertoy.com/view/XslGRr
    License Creative Commons Attribution-NonCommercial-ShareAlike 3.0 Unported License" Name="Clouds Generation">
    <Shader OutputBitDepth="Output" Index="1">
        <Uniform Index="0" NoInput="Error" Tooltip="" DisplayName="Front Noise" Mipmaps="False" GL_TEXTURE_WRAP_T="GL_REPEAT" GL_TEXTURE_WRAP_S="GL_REPEAT" GL_TEXTURE_MAG_FILTER="GL_LINEAR" GL_TEXTURE_MIN_FILTER="GL_LINEAR" Type="sampler2D" Name="inputNoise">
        </Uniform>
        <Uniform Inc="0.01" Tooltip="" Row="0" Col="0" Page="0" DisplayName="Clouds Rotation" Type="vec2" Name="paramPos">
            <SubUniform ResDependent="None" Max="2.0" Min="0.0" Default="0.0">
            </SubUniform>
            <SubUniform ResDependent="None" Max="2.0" Min="0.0" Default="0.0">
            </SubUniform>
        </Uniform>
        <Uniform Row="2" Col="0" Page="0" Default="False" Tooltip="" DisplayName="Procedural generation" Type="bool" Name="paramProcedural">
        </Uniform>
        <Uniform ResDependent="None" Max="100.0" Min="1.0" Default="10.0" Inc="1.0" Tooltip="" Row="3" Col="0" Page="0" DisplayName="Speed" Type="float" Name="paramSpeed">
        </Uniform>
    </Shader>
    <Page Name="Page 1" Page="0">
        <Col Name="Column 1" Col="0" Page="0">
        </Col>
    </Page>
</ShaderNodePreset>