<ShaderNodePreset SupportsAdaptiveDegradation="0" Description="
This Matchbox shader creates a mandelbrot pattern.

Setup:

- Speed : speed of building the fractal
- Offset : creates different fractal
- Colour: fractal base colour

Demo clip: http://vimeo.com/82553863

Based on https://www.shadertoy.com/view/lsB3zR

ivar@inferno-op.com" Name="Preset Name">
   <Shader OutputBitDepth="Output" Index="1">
      <Uniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="1.13" Inc="0.01" Tooltip="" Row="0" Col="0" Page="0" DisplayName="Speed" Type="float" Name="Speed">
      </Uniform>
      <Uniform ResDependent="None" Max="1000000.0" Min="-1000000.0" Default="3.49" Inc="0.1" Tooltip="" Row="1" Col="0" Page="0" DisplayName="Offset" Type="float" Name="time">
      </Uniform>
      <Uniform Inc="0.01" Tooltip="" Row="2" Col="0" Page="0" DisplayName="Colour" ValueType="Colour" Type="vec3" Name="vBaseColour">
         <SubUniform ResDependent="None" Max="5.0" Min="0.0" Default="0.232">
         </SubUniform>
         <SubUniform ResDependent="None" Max="5.0" Min="0.0" Default="0.48">
         </SubUniform>
         <SubUniform ResDependent="None" Max="5.0" Min="0.0" Default="0.64">
         </SubUniform>
      </Uniform>
   </Shader>
   <Page Name="Page 1" Page="0">
      <Col Name="Column 1" Col="0" Page="0">
      </Col>
   </Page>
</ShaderNodePreset>