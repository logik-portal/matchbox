dvec3 pack3xDouble6x32(uvec2 r, uvec2 g, uvec2 b) {
    return dvec3(packDouble2x32(r), packDouble2x32(g), packDouble2x32(b));
}

dvec3 cbrt(dvec3 x) {
    const double scale[] = {
        .6299605249474366lf,
        .7937005259840997lf,
        1.lf,
        1.259921049894873lf,
        1.587401051968199lf
    };
    dvec3 s = sign(x);
    x = abs(x);
    ivec3 e;
    dvec3 m = frexp(x, e);
    dvec3 y = .4943965824016093lf + (.6944362432644339lf - .1893976029726157lf * m) * m;
    dvec3 t = y * y * y;
    y *= (t + 2.lf * m) / (2.lf * t + m);
    ivec3 e_3 = e / 3;
    e -= 3 * e_3;
    y *= dvec3(scale[e.r + 2], scale[e.g + 2], scale[e.b + 2]);
    y = ldexp(y, e_3);
    y = (2.lf * y + x / (y * y)) / 3.lf;
    return s * y;
}

vec3 cbrt_f(vec3 x) {
    const float scale[] = {
        .6299605249474366,
        .7937005259840997,
        1.,
        1.259921049894873,
        1.587401051968199
    };
    vec3 s = sign(x);
    vec3 a = abs(x);
    ivec3 e;
    vec3 m = frexp(a, e);
    vec3 y = .4943965824016093 + (.6944362432644339 - .1893976029726157 * m) * m;
    ivec3 e_3 = e / 3;
    e -= 3 * e_3;
    y *= vec3(scale[e.r + 2], scale[e.g + 2], scale[e.b + 2]);
    y = ldexp(y, e_3);
    y = (2. * y + a / (y * y)) / 3.;
    y = (2. * y + a / (y * y)) / 3.;
    return s * y;
}

void main() {
    vec3 col = texelFetch(front, ivec2(gl_FragCoord.xy), 0).rgb;
    float sel = texelFetch(selective, ivec2(gl_FragCoord.xy), 0).b;
    if (double_precision) {
        dvec3 dcol = col;
        dmat3 mat;
        {
            vec4 f_0 = texelFetch(adsk_results_pass1, ivec2(0), 0);
            vec4 f_1 = texelFetch(adsk_results_pass1, ivec2(1, 0), 0);
            uvec4 u_0 = floatBitsToUint(f_0);
            uvec4 u_1 = floatBitsToUint(f_1);
            dvec3 col_0 = pack3xDouble6x32(u_0.rg, u_0.ba, u_1.rg);
            f_0 = texelFetch(adsk_results_pass1, ivec2(2, 0), 0);
            u_0 = floatBitsToUint(f_0);
            dvec3 col_1 = pack3xDouble6x32(u_1.ba, u_0.rg, u_0.ba);
            f_0 = texelFetch(adsk_results_pass1, ivec2(3, 0), 0);
            vec2 f_2 = texelFetch(adsk_results_pass1, ivec2(4, 0), 0).rg;
            u_0 = floatBitsToUint(f_0);
            uvec2 u_2 = floatBitsToUint(f_2);
            dvec3 col_2 = pack3xDouble6x32(u_0.rg, u_0.ba, u_2);
            mat = dmat3(col_0, col_1, col_2);
        }
        if (perceptual) {
            dcol = to_lms[working_cs] * dcol;
            dcol = cbrt(dcol);
        }
        dcol = mix(dcol, mat * dcol, double(sel));
        if (perceptual) {
            dcol = dcol * dcol * dcol;
            dcol = from_lms[working_cs] * dcol;
        }
        fragColor = vec4(dcol, 1.);
        return;
    }
    mat3 mat = mat3(texelFetch(adsk_results_pass1, ivec2(0), 0).rgb, texelFetch(adsk_results_pass1, ivec2(1, 0), 0).rgb, texelFetch(adsk_results_pass1, ivec2(2, 0), 0).rgb);
    if (perceptual) {
        col = to_lms_f[working_cs] * col;
        col = cbrt_f(col);
    }
    col = mix(col, mat * col, sel);
    if (perceptual) {
        col = col * col * col;
        col = from_lms_f[working_cs] * col;
    }
    fragColor = vec4(col, 1.);
}
