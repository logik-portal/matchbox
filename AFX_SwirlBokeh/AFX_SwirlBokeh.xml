<?xml version="1.0" encoding="UTF-8"?>
<ShaderNodePreset 
    Name="AFX Swirl Bokeh"
    Description="Bring out your inner Greig Fraser with this plugin that recreates the classic swirl bokeh made popular by vintage lenses such as the Petzval series.

WARNING: High values will be very demanding on your GPU.
    
Made by John Ashby"
    ShaderType="Matchbox"
    SoftwareVersion="2025.0.0"
    Version="1.1"
    
    SupportsAction="True"
    SupportsTransition="False"
    SupportsTimeline="True"
    MatteProvider="False"
    TimelineUseBack="False"
    DefaultIsNoOp="False"
    
    LimitInputsToTexture="True"
    SupportsAdaptiveDegradation="False"
    CommercialUsePermitted="True">
    
    <!-- PASS 1: Chromatic Aberration -->
    <Shader 
        Index="1"
        OutputBitDepth="Float16">
        
        <!-- Input texture -->
        <Uniform 
            Index="0"
            Name="frontTex"
            DisplayName="Front"
            Type="sampler2D"
            InputType="Front"
            NoInput="Error"
            
            Mipmaps="True"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR_MIPMAP_LINEAR"
            
            Tooltip="Input image (mipmaps enabled for fast R/B blur)">
        </Uniform>
        
        <!-- Column 0: Bokeh Controls -->
        <Uniform 
            Name="blurAmount"
            Type="float"
            DisplayName="Blur Amount"
            
            Default="10.0"
            Min="0.0"
            Max="100.0"
            Inc="0.5"
            ResDependent="None"
            
            Page="0" Col="0" Row="0"
            Tooltip="Blur radius in pixels">
        </Uniform>
        
        <Uniform 
            Name="kernelSides"
            Type="float"
            DisplayName="Kernel Sides"
            
            Default="9.0"
            Min="3.0"
            Max="12.0"
            Inc="1.0"
            ResDependent="None"
            
            Page="0" Col="0" Row="1"
            Tooltip="Number of polygon sides for kernel shape (3=triangle, 5=pentagon, 6=hexagon, 12=circle)">
        </Uniform>

        <Uniform 
            Name="baseRotation"
            Type="float"
            DisplayName="Kernal Rotation"
            
            Default="0.0"
            Min="-180.0"
            Max="180.0"
            Inc="1.0"
            ResDependent="None"
            
            Page="0" Col="0" Row="2"
            Tooltip="Base rotation offset for kernel shape (degrees)">
        </Uniform>

        
        <!-- Column 1: Swirl Controls -->
        

        <Uniform 
            Name="catsEyeOn"
            Type="bool"
            DisplayName="Enable"
            
            Default="True"
            ResDependent="None"
            
            Page="0" Col="1" Row="0"
            Tooltip="Enable off-axis cat's-eye bokeh deformation (optional enhancement)">
        </Uniform>
        
        <Uniform 
            Name="catsEyeStrength"
            Type="float"
            DisplayName="Cats Eye Shape"
            
            Default="0.8"
            Min="0.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="1" Row="1"
            Tooltip="How strongly the kernal has a cats eye shape (0=off, 1=max)">
        </Uniform>

        <Uniform 
            Name="squish"
            Type="float"
            DisplayName="Edge Flatten"
            
            Default="0.0"
            Min="-1.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="1" Row="2"
            Tooltip="Flatten one side of kernel toward edges (−1=right, 0=symmetric, +1=left)">
        </Uniform>
        
        <Uniform 
            Name="falloffCurve"
            Type="float"
            DisplayName="Falloff Curve"
            
            Default="1.0"
            Min="0.1"
            Max="4.0"
            Inc="0.1"
            ResDependent="None"
            
            Page="0" Col="1" Row="3"
            Tooltip="Non-linear falloff curve (1.0=linear, under 1.0=gradual, over 1.0=non linear exponential)">
        </Uniform>

        
        <!-- Column 4: Lens Mush Controls -->
        <Uniform 
            Name="mushOn"
            Type="bool"
            DisplayName="Enable"
            
            Default="True"
            ResDependent="None"
            
            Page="0" Col="4" Row="0"
            Tooltip="Enable lens mush effect (radial + zoom blur)">
        </Uniform>
        
        <Uniform 
            Name="mushStrength"
            Type="float"
            DisplayName="Strength"
            
            Default="0.5"
            Min="0.0"
            Max="3.0"
            Inc="0.1"
            ResDependent="None"
            
            Page="0" Col="4" Row="1"
            Tooltip="Strength of lens mush effect">
        </Uniform>
        
        <Uniform 
            Name="mushSize"
            Type="float"
            DisplayName="Mush Size"
            
            Default="1.0"
            Min="0.01"
            Max="2.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="4" Row="2"
            Tooltip="Size of lens mush area (larger = more of image affected, smaller = effect only at edges)">
        </Uniform>
        
        <!-- Column 5: Vignette Controls -->
        <Uniform 
            Name="vignetteOn"
            Type="bool"
            DisplayName="Enable"
            
            Default="False"
            ResDependent="None"
            
            Page="0" Col="5" Row="0"
            Tooltip="Enable vignette (edge darkening)">
        </Uniform>
        
        <Uniform 
            Name="vignetteStrength"
            Type="float"
            DisplayName="Strength"
            
            Default="10.0"
            Min="0.0"
            Max="10.0"
            Inc="0.1"
            ResDependent="None"
            
            Page="0" Col="5" Row="1"
            Tooltip="Vignette darkening in stops (0=no effect, 1=-1 stop, 2=-2 stops, 5=-5 stops)">
        </Uniform>
        
        <Uniform 
            Name="vignetteSize"
            Type="float"
            DisplayName="Vignette Size"
            
            Default="1.25"
            Min="0.1"
            Max="2.0"
            Inc="0.05"
            ResDependent="None"
            
            Page="0" Col="5" Row="2"
            Tooltip="Size of vignette area (larger = more of image affected, smaller = vignette only at edges)">
        </Uniform>
        
        <Uniform 
            Name="vignetteFalloff"
            Type="float"
            DisplayName="Falloff Curve"
            
            Default="2.0"
            Min="0.1"
            Max="10.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="5" Row="3"
            Tooltip="Vignette falloff curve (1.0=linear, under 1.0=gradual, over 1.0=sharper transition, 10.0=very steep)">
        </Uniform>
        
        <!-- Column 2: Chromatic Aberration Controls -->
        <Uniform 
            Name="chromaticOn"
            Type="bool"
            DisplayName="Enable"
            
            Default="True"
            ResDependent="None"
            
            Page="0" Col="2" Row="0"
            Tooltip="Enable chromatic aberration">
        </Uniform>
        
        <Uniform 
            Name="redScale"
            Type="float"
            DisplayName="Red Scale"
            
            Default="-0.5"
            Min="-1.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="2" Row="1"
            Tooltip="Red channel chromatic aberration scale (-1 to +1, internally scaled to ±0.005)">
        </Uniform>
        
        <Uniform 
            Name="blueScale"
            Type="float"
            DisplayName="Blue Scale"
            
            Default="0.5"
            Min="-1.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="2" Row="2"
            Tooltip="Blue channel chromatic aberration scale (-1 to +1, internally scaled to ±0.005)">
        </Uniform>

        <Uniform 
            Name="chromaticBlur"
            Type="float"
            DisplayName="Chromatic Blur"
            
            Default="0.5"
            Min="0.0"
            Max="2.0"
            Inc="0.1"
            ResDependent="None"
            
            Page="0" Col="2" Row="3"
            Tooltip="Subtle mip LOD blur applied equally to RGB (edge-weighted)">
        </Uniform>
        
    </Shader>
    
    <!-- PASS 2: Kernel Blur -->
    <Shader 
        Index="2"
        OutputBitDepth="Output">
        
        <!-- Result from pass 1 -->
        <Uniform 
            Name="adsk_results_pass1"
            Type="sampler2D"
            
            Mipmaps="False"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR"
            
            Tooltip="Result from chromatic aberration pass">
        </Uniform>
        
        <!-- Column 0: Bokeh Controls -->
        <Uniform Name="blurAmount" Type="float"><Duplicate /></Uniform>
        <Uniform Name="kernelSides" Type="float"><Duplicate /></Uniform>
        <Uniform Name="baseRotation" Type="float"><Duplicate /></Uniform>
        
        <!-- Column 5: Cat's Eye Controls -->
        <Uniform Name="catsEyeOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="catsEyeStrength" Type="float"><Duplicate /></Uniform>
        
        
        <!-- Column 1: Swirl Controls -->
        <Uniform Name="squish" Type="float"><Duplicate /></Uniform>
        <Uniform Name="falloffCurve" Type="float"><Duplicate /></Uniform>
        
    </Shader>
    
    <!-- PASS 3: Lens Breathing -->
    <Shader 
        Index="3"
        OutputBitDepth="Float16">
        
        <!-- Result from pass 2 -->
        <Uniform 
            Name="adsk_results_pass2"
            Type="sampler2D"
            
            Mipmaps="False"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR"
            
            Tooltip="Result from kernel blur pass">
        </Uniform>
        
        <!-- Column 6: Lens Breathing Controls -->
        <Uniform 
            Name="breathingOn"
            Type="bool"
            DisplayName="Enable"
            
            Default="False"
            
            Page="0" Col="3" Row="0"
            Tooltip="Enable focus breathing effect">
        </Uniform>
        
        <Uniform 
            Name="breathingX"
            Type="float"
            DisplayName="Breathing X"
            
            Default="0.0"
            Min="0.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="3" Row="1"
            Tooltip="X-axis lens breathing (0=100%, 1=110% scale)">
        </Uniform>
        
        <Uniform 
            Name="breathingY"
            Type="float"
            DisplayName="Breathing Y"
            
            Default="0.0"
            Min="0.0"
            Max="1.0"
            Inc="0.01"
            ResDependent="None"
            
            Page="0" Col="3" Row="2"
            Tooltip="Y-axis lens breathing (0=100%, 1=110% scale)">
        </Uniform>
        
        <!-- Need blur amount for breathing calculation -->
        <Uniform Name="blurAmount" Type="float"><Duplicate /></Uniform>
        
    </Shader>
    
    <!-- PASS 4: Radial Blur -->
    <Shader 
        Index="4"
        OutputBitDepth="Float16">
        
        <!-- Result from pass 3 (lens breathing) -->
        <Uniform 
            Name="adsk_results_pass3"
            Type="sampler2D"
            
            Mipmaps="False"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR"
            
            Tooltip="Result from radial blur pass">
        </Uniform>
        
        <!-- Lens Mush Controls -->
        <Uniform Name="mushOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="mushStrength" Type="float"><Duplicate /></Uniform>
        <Uniform Name="mushSize" Type="float"><Duplicate /></Uniform>
        
        <!-- Lens Breathing Controls -->
        <Uniform Name="breathingOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="breathingX" Type="float"><Duplicate /></Uniform>
        <Uniform Name="breathingY" Type="float"><Duplicate /></Uniform>
        
    </Shader>
    
    <!-- PASS 5: Zoom Blur -->
    <Shader 
        Index="5"
        OutputBitDepth="Float16">
        
        <!-- Result from pass 4 (radial blur) -->
        <Uniform 
            Name="adsk_results_pass4"
            Type="sampler2D"
            
            Mipmaps="False"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR"
            
            Tooltip="Result from zoom blur pass">
        </Uniform>
        
        <!-- Lens Mush Controls -->
        <Uniform Name="mushOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="mushStrength" Type="float"><Duplicate /></Uniform>
        <Uniform Name="mushSize" Type="float"><Duplicate /></Uniform>
        
        <!-- Lens Breathing Controls -->
        <Uniform Name="breathingOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="breathingX" Type="float"><Duplicate /></Uniform>
        <Uniform Name="breathingY" Type="float"><Duplicate /></Uniform>
        
    </Shader>
    
    <!-- PASS 6: Vignette -->
    <Shader 
        Index="6"
        OutputBitDepth="Float16">
        
        <!-- Result from pass 5 (zoom blur) -->
        <Uniform 
            Name="adsk_results_pass5"
            Type="sampler2D"
            
            Mipmaps="False"
            GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
            GL_TEXTURE_MAG_FILTER="GL_LINEAR"
            GL_TEXTURE_MIN_FILTER="GL_LINEAR"
            
            Tooltip="Result from zoom blur pass">
        </Uniform>
        
        <!-- Vignette Controls -->
        <Uniform Name="vignetteOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="vignetteStrength" Type="float"><Duplicate /></Uniform>
        <Uniform Name="vignetteSize" Type="float"><Duplicate /></Uniform>
        <Uniform Name="vignetteFalloff" Type="float"><Duplicate /></Uniform>
        
        <!-- Lens Breathing Controls -->
        <Uniform Name="breathingOn" Type="bool"><Duplicate /></Uniform>
        <Uniform Name="breathingX" Type="float"><Duplicate /></Uniform>
        <Uniform Name="breathingY" Type="float"><Duplicate /></Uniform>
        
    </Shader>
    
    <!-- Page Layout -->
    <Page Name="Swirl Bokeh" Page="0">
        <Col Name="Bokeh" Col="0" Page="0" />
        <Col Name="Swirl" Col="1" Page="0" />
        <Col Name="Chromatic Aberration" Col="2" Page="0" />
        <Col Name="Focus Breathing" Col="3" Page="0" />
        <Col Name="Lens Mush" Col="4" Page="0" />
        <Col Name="Vignette" Col="5" Page="0" />
    </Page>
    
    </ShaderNodePreset>
